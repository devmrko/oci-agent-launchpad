#!/bin/bash
set -euo pipefail
# Grow the guest filesystem before kubelet advertises ephemeral capacity.
/usr/libexec/oci-growfs -y
root_bytes=$(df -B1 --output=size / | tail -1 | tr -d ' ')
if (( root_bytes < ${required_root_bytes} )); then
  echo 'OKE_NODE_CAPACITY_FAILED: root filesystem is below the configured budget' >&2
  exit 1
fi
# Preserve the required OKE bootstrap supplied by the instance metadata service.
curl --fail -H 'Authorization: Bearer Oracle' -L0 http://169.254.169.254/opc/v2/instance/metadata/oke_init_script | base64 --decode > /var/run/oke-init.sh
bash /var/run/oke-init.sh
